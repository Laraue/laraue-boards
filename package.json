{
  "name": "laraue-boards-new-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev --public",
    "typecheck": "nuxt typecheck && vue-tsc -p tsconfig.test.json",
    "lint": "oxlint && eslint .",
    "lint:fix": "oxlint --fix && eslint . --fix",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "style": "stylelint \"**/*.{css,vue}\"",
    "style:fix": "stylelint \"**/*.{css,vue}\" --fix",
    "fix": "pnpm lint:fix && pnpm format:fix && pnpm style:fix",
    "test": "vitest run",
    "test:browser:ui": "vitest --project=browser --browser.headless=false",
    "api": "pnpm api:boards && pnpm api:retro && pnpm api:billing",
    "api:boards": "openapi-typescript http://localhost:5200/openapi/v1.json -o infrastructure/api/generated.ts",
    "api:billing": "openapi-typescript http://localhost:5262/openapi/v1.json -o infrastructure/api/billing.generated.ts",
    "api:retro": "openapi-typescript http://localhost:5201/openapi/v1.json -o infrastructure/api/retro.generated.ts",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "pre-commit": "pnpm fix && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@dnd-kit/abstract": "^0.5.1",
    "@dnd-kit/dom": "^0.5.1",
    "@dnd-kit/helpers": "^0.5.1",
    "@dnd-kit/vue": "^0.5.1",
    "@internationalized/date": "^3.12.4",
    "@microsoft/signalr": "^10.0.11",
    "@nuxtjs/i18n": "^10.6.0",
    "@nuxtjs/sitemap": "^9.1.0",
    "@tabler/icons-vue": "^3.50.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-list": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/markdown": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@tiptap/vue-3": "^3.32.0",
    "diff": "^9.0.0",
    "driver.js": "^1.10.2",
    "es-toolkit": "^1.53.0",
    "isomorphic-dompurify": "^4.6.0",
    "marked": "^18.1.2",
    "nuxt": "^4.6.3",
    "nuxt-gtag": "5.0.0",
    "nuxt-schema-org": "^7.0.1",
    "nuxt-seo-utils": "^9.0.1",
    "reka-ui": "^2.11.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@nuxt/test-utils": "^4.3.4",
    "@types/node": "^24.13.3",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.13.0",
    "eslint-plugin-perfectionist": "^5.13.0",
    "eslint-plugin-vue": "^10.12.0",
    "happy-dom": "^21.0.4",
    "openapi-fetch": "^0.17.0",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "playwright": "^1.64.1",
    "postcss-html": "^2.0.0",
    "stylelint": "^17.16.0",
    "stylelint-order": "^8.1.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.13"
  }
}
