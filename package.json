{
  "name": "laraue-boards-new-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev --public",
    "typecheck": "nuxt typecheck && vue-tsc -p tsconfig.test.json",
    "lint": "oxlint && eslint .",
    "lint:fix": "oxlint --fix && eslint . --fix",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "style": "stylelint \"**/*.{css,vue}\"",
    "style:fix": "stylelint \"**/*.{css,vue}\" --fix",
    "fix": "pnpm lint:fix && pnpm format:fix && pnpm style:fix",
    "test": "vitest run",
    "test:browser:ui": "vitest --project=browser --browser.headless=false",
    "api": "pnpm api:boards && pnpm api:retro",
    "api:boards": "openapi-typescript http://localhost:5200/openapi/v1.json -o infrastructure/api/generated.ts",
    "api:retro": "openapi-typescript http://localhost:5201/openapi/v1.json -o infrastructure/api/retro.generated.ts",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "pre-commit": "pnpm fix && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@dnd-kit/abstract": "^0.5.0",
    "@dnd-kit/dom": "^0.5.0",
    "@dnd-kit/helpers": "^0.5.0",
    "@dnd-kit/vue": "^0.5.0",
    "@lucide/vue": "^1.26.0",
    "@microsoft/signalr": "^10.0.11",
    "diff": "^9.0.0",
    "driver.js": "^1.8.0",
    "es-toolkit": "^1.52.0",
    "isomorphic-dompurify": "^4.1.0",
    "marked": "^18.0.11",
    "nuxt": "^4.5.2",
    "nuxt-gtag": "5.0.0",
    "vue": "^3.5.40",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@nuxt/test-utils": "^4.2.0",
    "@types/node": "^24.13.3",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "@vue/test-utils": "^2.5.0",
    "eslint": "^10.9.1",
    "eslint-plugin-perfectionist": "^5.11.0",
    "eslint-plugin-vue": "^10.10.0",
    "happy-dom": "^20.13.2",
    "openapi-fetch": "^0.17.0",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "playwright": "^1.62.1",
    "postcss-html": "^2.0.0",
    "stylelint": "^17.14.1",
    "stylelint-order": "^8.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  }
}
