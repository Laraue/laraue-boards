{
  "name": "laraue-boards-new-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev --public",
    "typecheck": "nuxt typecheck && vue-tsc -p tsconfig.test.json",
    "lint": "oxlint && eslint .",
    "lint:fix": "oxlint --fix && eslint . --fix",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "style": "stylelint \"**/*.{css,vue}\"",
    "style:fix": "stylelint \"**/*.{css,vue}\" --fix",
    "fix": "pnpm lint:fix && pnpm format:fix && pnpm style:fix",
    "test": "vitest run",
    "test:browser:ui": "vitest --project=browser --browser.headless=false",
    "api": "openapi-typescript http://localhost:5200/openapi/v1.json -o infrastructure/api/generated.ts",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "pre-commit": "pnpm fix && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@dnd-kit/dom": "^0.5.0",
    "@dnd-kit/helpers": "^0.5.0",
    "@dnd-kit/vue": "^0.5.0",
    "@lucide/vue": "^1.26.0",
    "es-toolkit": "^1.50.0",
    "nuxt": "^4.5.0",
    "nuxt-gtag": "4.1.0",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@nuxt/test-utils": "^4.0.3",
    "@types/node": "^24.0.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.8.0",
    "eslint-plugin-perfectionist": "^5.10.0",
    "eslint-plugin-vue": "^10.10.0",
    "happy-dom": "^20.11.1",
    "openapi-fetch": "^0.17.0",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "playwright": "^1.61.1",
    "postcss-html": "^1.8.1",
    "stylelint": "^17.14.1",
    "stylelint-order": "^8.1.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.8"
  }
}
